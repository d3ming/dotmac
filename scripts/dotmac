#!/bin/bash
set -euo pipefail

repo_dir=$(cd "$(dirname "$0")/.." && pwd -P)
json=0

usage() {
	cat <<'EOF'
Usage:
  scripts/dotmac [--json] profiles
  scripts/dotmac [--json] plan --profile NAME
  scripts/dotmac [--json] outdated --profile NAME
  scripts/dotmac [--json] apply --profile NAME
  scripts/dotmac [--json] upgrade --profile NAME
  scripts/dotmac [--json] inventory
  scripts/dotmac [--json] home check|apply
  scripts/dotmac [--json] preferences check|apply|restore BACKUP_FILE
  scripts/dotmac [--json] disk snapshot [PATH...]
  scripts/dotmac [--json] disk diff [OLD NEW]
  scripts/dotmac [--json] --help|--version

Profiles: essential, development, diagnostics, gui-apps, data

`plan`, `outdated`, `inventory`, and `home check` do not install or upgrade packages.
`apply` installs missing profile entries without deliberate upgrades.
`upgrade` installs missing and upgrades outdated entries in only that profile;
it never removes undeclared packages. Home links are previewed first.
macOS preferences remain a separate, explicit action.
`disk snapshot` records per-directory usage (depth 2, via dua) for $HOME and
the user temp directory into .agent-local/disk/ (override DOTMAC_DISK_DIR);
`disk diff` compares the two newest snapshots, or OLD and NEW. Both are
read-only for the scanned paths.
EOF
}

json_quote() {
	local value=$1
	value=${value//\\/\\\\}
	value=${value//\"/\\\"}
	value=${value//$'\n'/\\n}
	value=${value//$'\r'/\\r}
	value=${value//$'\t'/\\t}
	printf '"%s"' "$value"
}

result() {
	local ok=$1 operation=$2 target=$3 state=$4 code=$5 details=$6
	if (( json )); then
		printf '{"ok":%s,"operation":' "$ok"
		json_quote "$operation"
		printf ',"target":'
		json_quote "$target"
		printf ',"status":'
		json_quote "$state"
		printf ',"exit_code":%s,"details":' "$code"
		json_quote "$details"
		printf '}\n'
	elif [[ -n $details ]]; then
		printf '%s\n' "$details"
	fi
}

fail() {
	local message=$1 code=${2:-2}
	if (( json )); then
		result false error dotmac error "$code" "$message"
	else
		printf 'dotmac: %s\n' "$message" >&2
	fi
	exit "$code"
}

profile_file() {
	case $1 in
		essential) printf '%s/Brewfile\n' "$repo_dir" ;;
		development) printf '%s/Brewfile.development\n' "$repo_dir" ;;
		gui-apps) printf '%s/Brewfile.gui-apps\n' "$repo_dir" ;;
		data) printf '%s/Brewfile.data\n' "$repo_dir" ;;
		diagnostics) printf '%s/Brewfile.diagnostics\n' "$repo_dir" ;;
		*) return 1 ;;
	esac
}

cask_artifact_for() {
	case $1 in
		ghostty) printf 'app:Ghostty.app\n' ;;
		zed) printf 'app:Zed.app\n' ;;
		obsidian) printf 'app:Obsidian.app\n' ;;
		rectangle) printf 'app:Rectangle.app\n' ;;
		1password) printf 'app:1Password.app\n' ;;
		1password-cli) printf 'command:op\n' ;;
		*) return 1 ;;
	esac
}

require_macos() {
	[[ $(uname -s) == Darwin ]] || fail 'this command is for macOS' 2
}

require_brew() {
	command -v brew >/dev/null 2>&1 || fail 'Homebrew is required; review https://docs.brew.sh/Installation before installing it' 127
}

mark_cask_skipped() {
	local token=$1 artifact=$2
	case " $DOTMAC_CASK_SKIP " in
		*" $token "*) ;;
		*) DOTMAC_CASK_SKIP="${DOTMAC_CASK_SKIP:+$DOTMAC_CASK_SKIP }$token" ;;
	esac
	DOTMAC_NOTES+="${DOTMAC_NOTES:+$'\n'}present but not Homebrew-managed; skipped without taking ownership: $artifact"
}

# Homebrew Bundle only treats registered casks as installed. Skip a known app
# bundle already in Applications or a known CLI command already on PATH without
# taking ownership or changing the existing artifact.
find_unmanaged_casks() {
	local brewfile=$1 token artifact app command_name
	DOTMAC_NOTES=''
	DOTMAC_CASK_SKIP=${HOMEBREW_BUNDLE_CASK_SKIP:-}
	while IFS= read -r token; do
		[[ -n $token ]] || continue
		if ! artifact=$(cask_artifact_for "$token"); then
			fail "cask '$token' has no artifact mapping in scripts/dotmac" 2
		fi
		if brew list --cask --versions "$token" >/dev/null 2>&1; then
			continue
		fi
		case $artifact in
			app:*)
				app=${artifact#app:}
				if [[ -d "/Applications/$app" || -d "$HOME/Applications/$app" ]]; then
					mark_cask_skipped "$token" "app bundle $app"
				fi
				;;
			command:*)
				command_name=${artifact#command:}
				if command -v "$command_name" >/dev/null 2>&1; then
					mark_cask_skipped "$token" "command $command_name on PATH"
				fi
				;;
		esac
	done < <(sed -nE 's/^[[:space:]]*cask[[:space:]]+"([^"]+)".*/\1/p' "$brewfile")
}

list_contains() {
	local list=$1 wanted=$2 line
	while IFS= read -r line; do
		[[ $line == "$wanted" ]] && return 0
	done <<< "$list"
	return 1
}

profile_outdated() {
	local file=$1 formula_list cask_list installed_formula_list installed_cask_list token output rc line
	local -a installed_formulae=() installed_casks=()
	DOTMAC_OUTDATED=''

	if formula_list=$(brew bundle list --file "$file" --formula 2>&1); then
		:
	else
		rc=$?
		fail "could not list profile formulae: $formula_list" "$rc"
	fi
	if cask_list=$(brew bundle list --file "$file" --cask 2>&1); then
		:
	else
		rc=$?
		fail "could not list profile casks: $cask_list" "$rc"
	fi
	if installed_formula_list=$(brew list --formula 2>&1); then
		:
	else
		rc=$?
		fail "could not read installed Homebrew formulae: $installed_formula_list" "$rc"
	fi
	if installed_cask_list=$(brew list --cask 2>&1); then
		:
	else
		rc=$?
		fail "could not read installed Homebrew casks: $installed_cask_list" "$rc"
	fi

	while IFS= read -r token; do
		[[ -n $token ]] || continue
		if list_contains "$installed_formula_list" "$token"; then
			installed_formulae+=("$token")
		fi
	done <<< "$formula_list"
	while IFS= read -r token; do
		[[ -n $token ]] || continue
		case " $DOTMAC_CASK_SKIP " in *" $token "*) continue ;; esac
		if list_contains "$installed_cask_list" "$token"; then
			installed_casks+=("$token")
		fi
	done <<< "$cask_list"

	if ((${#installed_formulae[@]})); then
		if output=$(brew outdated --formula --quiet "${installed_formulae[@]}" 2>&1); then
			rc=0
		else
			rc=$?
		fi
		if (( rc != 0 )) && [[ -z $output ]]; then
			fail 'Homebrew could not check profile formula updates' "$rc"
		fi
		while IFS= read -r line; do
			[[ -n $line ]] || continue
			case " ${installed_formulae[*]} " in
				*" $line "*) DOTMAC_OUTDATED+="${DOTMAC_OUTDATED:+$'\n'}formula $line" ;;
				*) fail "unexpected brew outdated formula result: $line" "$rc" ;;
			esac
		done <<< "$output"
	fi
	if ((${#installed_casks[@]})); then
		if output=$(brew outdated --cask --quiet "${installed_casks[@]}" 2>&1); then
			rc=0
		else
			rc=$?
		fi
		if (( rc != 0 )) && [[ -z $output ]]; then
			fail 'Homebrew could not check profile cask updates' "$rc"
		fi
		while IFS= read -r line; do
			[[ -n $line ]] || continue
			case " ${installed_casks[*]} " in
				*" $line "*) DOTMAC_OUTDATED+="${DOTMAC_OUTDATED:+$'\n'}cask $line" ;;
				*) fail "unexpected brew outdated cask result: $line" "$rc" ;;
			esac
		done <<< "$output"
	fi
}

install_bundle_and_verify() {
	local profile=$1 file=$2 check_output rc details
	if (( json )); then
		if HOMEBREW_BUNDLE_CASK_SKIP="$DOTMAC_CASK_SKIP" brew bundle install --no-upgrade --file "$file" >&2; then
			:
		else
			rc=$?
			result false apply "$profile" failed "$rc" "$DOTMAC_NOTES"
			return "$rc"
		fi
	else
		if HOMEBREW_BUNDLE_CASK_SKIP="$DOTMAC_CASK_SKIP" brew bundle install --no-upgrade --file "$file"; then
			:
		else
			rc=$?
			result false apply "$profile" failed "$rc" "$DOTMAC_NOTES"
			return "$rc"
		fi
	fi

	if check_output=$(HOMEBREW_BUNDLE_CASK_SKIP="$DOTMAC_CASK_SKIP" brew bundle check --no-upgrade --file "$file" 2>&1); then
		details="$DOTMAC_NOTES${DOTMAC_NOTES:+$'\n'}${check_output:+$check_output$'\n'}Homebrew Bundle verified the profile after installation."
		result true apply "$profile" verified 0 "$details"
		return 0
	else
		rc=$?
		result false apply "$profile" verification-failed "$rc" "$check_output"
		return "$rc"
	fi
}

upgrade_profile() {
	local profile=$1 file=$2 check_output rc missing=0 details
	if check_output=$(HOMEBREW_BUNDLE_CASK_SKIP="$DOTMAC_CASK_SKIP" brew bundle check --no-upgrade --file "$file" 2>&1); then
		:
	else
		missing=1
	fi
	profile_outdated "$file"
	if (( ! missing )) && [[ -z $DOTMAC_OUTDATED ]]; then
		details="$DOTMAC_NOTES${DOTMAC_NOTES:+$'\n'}Profile is installed and current; no changes needed."
		result true upgrade "$profile" already-current 0 "$details"
		return 0
	fi

	if (( json )); then
		if HOMEBREW_BUNDLE_CASK_SKIP="$DOTMAC_CASK_SKIP" brew bundle upgrade --file "$file" >&2; then
			:
		else
			rc=$?
			result false upgrade "$profile" failed "$rc" "$DOTMAC_NOTES"
			return "$rc"
		fi
	else
		if HOMEBREW_BUNDLE_CASK_SKIP="$DOTMAC_CASK_SKIP" brew bundle upgrade --file "$file"; then
			:
		else
			rc=$?
			result false upgrade "$profile" failed "$rc" "$DOTMAC_NOTES"
			return "$rc"
		fi
	fi

	if check_output=$(HOMEBREW_BUNDLE_CASK_SKIP="$DOTMAC_CASK_SKIP" brew bundle check --no-upgrade --file "$file" 2>&1); then
		:
	else
		rc=$?
		result false upgrade "$profile" verification-failed "$rc" "$check_output"
		return "$rc"
	fi
	profile_outdated "$file"
	if [[ -n $DOTMAC_OUTDATED ]]; then
		details="Updates remain after Homebrew Bundle upgrade:"
		details+=$'\n'"$DOTMAC_OUTDATED"
		result false upgrade "$profile" verification-failed 1 "$details"
		return 1
	fi
	details="$DOTMAC_NOTES${DOTMAC_NOTES:+$'\n'}${check_output:+$check_output$'\n'}Homebrew Bundle verified the profile after upgrade."
	result true upgrade "$profile" verified 0 "$details"
}

profile_command() {
	local action=$1 profile='' file check_output details rc state
	shift
	while (($#)); do
		case $1 in
			--profile)
				(($# >= 2)) || fail '--profile requires a name' 2
				profile=$2
				shift 2
				;;
			--profile=*) profile=${1#*=}; shift ;;
			-h|--help) usage; return 0 ;;
			*) fail "unexpected argument: $1" 2 ;;
		esac
	done
	[[ -n $profile ]] || fail "$action requires --profile NAME" 2
	file=$(profile_file "$profile") || fail "unknown profile '$profile'; run 'scripts/dotmac profiles'" 2
	[[ -f $file ]] || fail "profile file is missing: $file" 2
	require_macos
	require_brew
	find_unmanaged_casks "$file"

	if [[ $action == plan ]]; then
		if check_output=$(HOMEBREW_BUNDLE_CASK_SKIP="$DOTMAC_CASK_SKIP" brew bundle check --no-upgrade --file "$file" 2>&1); then
			rc=0
		else
			rc=$?
		fi
		details="$DOTMAC_NOTES${DOTMAC_NOTES:+$'\n'}$check_output"
		if (( rc == 0 )); then
			result true plan "$profile" ready 0 "$details"
		else
			result false plan "$profile" incomplete "$rc" "$details"
		fi
		return "$rc"
	fi

	if [[ $action == outdated ]]; then
		profile_outdated "$file"
		if [[ -n $DOTMAC_OUTDATED ]]; then
			details="$DOTMAC_OUTDATED"
			state=updates-available
		else
			details='No outdated installed dependencies in this profile.'
			state=current
		fi
		details="$DOTMAC_NOTES${DOTMAC_NOTES:+$'\n'}$details"
		result true outdated "$profile" "$state" 0 "$details"
		return 0
	fi

	if [[ $action == upgrade ]]; then
		if upgrade_profile "$profile" "$file"; then
			return 0
		else
			rc=$?
			return "$rc"
		fi
	fi

	if check_output=$(HOMEBREW_BUNDLE_CASK_SKIP="$DOTMAC_CASK_SKIP" brew bundle check --no-upgrade --file "$file" 2>&1); then
		details="$DOTMAC_NOTES${DOTMAC_NOTES:+$'\n'}${check_output:+$check_output$'\n'}No changes needed; the profile is already satisfied."
		result true apply "$profile" already-satisfied 0 "$details"
		return 0
	fi
	install_bundle_and_verify "$profile" "$file"
}

home_command() {
	local action=$1 preview='' applied='' details='' rc
	(($# == 1)) || fail 'usage: scripts/dotmac home check|apply' 2
	case $action in check|apply) ;; *) fail 'usage: scripts/dotmac home check|apply' 2 ;; esac
	require_macos
	command -v stow >/dev/null 2>&1 || fail 'GNU Stow is required; apply the essential profile first' 127

	if preview=$(stow -n -v -d "$repo_dir/stow" -t "$HOME" home 2>&1); then
		:
	else
		rc=$?
		result false "home $action" home conflicts "$rc" "$preview"
		return "$rc"
	fi
	if [[ $action == check ]]; then
		result true 'home check' home clean 0 "$preview"
		return 0
	fi
	if applied=$(stow -v -d "$repo_dir/stow" -t "$HOME" home 2>&1); then
		# Git writes `--global` settings to ~/.config/git/config (tracked here) when ~/.gitconfig
		# is absent. Keep a private ~/.gitconfig so identity and tool-written settings stay local.
		if [[ ! -e $HOME/.gitconfig && ! -L $HOME/.gitconfig ]]; then
			(umask 077 && printf '%s\n' '# Machine- and account-specific Git settings (identity, credentials). Untracked; read after ~/.config/git/config.' > "$HOME/.gitconfig")
			applied+=$'\nCreated ~/.gitconfig for local Git settings'
		fi
		details=$'Preview:\n'"$preview"$'\nApply:\n'"$applied"
		result true 'home apply' home applied 0 "$details"
	else
		rc=$?
		details=$'Preview:\n'"$preview"$'\nApply failed:\n'"$applied"
		result false 'home apply' home failed "$rc" "$details"
		return "$rc"
	fi
}

preferences_command() {
	(($# >= 1)) || fail 'usage: scripts/dotmac preferences check|apply|restore BACKUP_FILE' 2
	local action=$1 output rc
	if output=$("$repo_dir/scripts/macos-preferences" "$@" 2>&1); then
		result true preferences "$action" complete 0 "$output"
	else
		rc=$?
		if [[ $action == check && $output == *'change:'* ]]; then
			result false preferences check different "$rc" "$output"
		else
			result false preferences "$action" failed "$rc" "$output"
		fi
		return "$rc"
	fi
}

inventory_command() {
	(($# == 0)) || fail 'inventory takes no arguments' 2
	require_macos
	require_brew
	local output rc
	if (( json )); then
		if output=$(brew bundle dump --file=- 2>&1); then
			result true inventory homebrew snapshot 0 "$output"
		else
			rc=$?
			result false inventory homebrew failed "$rc" "$output"
			return "$rc"
		fi
	else
		if brew bundle dump --file=-; then
			return 0
		else
			rc=$?
			return "$rc"
		fi
	fi
}

disk_dir() {
	printf '%s' "${DOTMAC_DISK_DIR:-$repo_dir/.agent-local/disk}"
}

disk_snapshot() {
	command -v dua >/dev/null 2>&1 || fail 'dua not found; run scripts/dotmac apply --profile diagnostics' 3
	local dir stamp out paths=("$@") tmpdir
	dir=$(disk_dir)
	if ((${#paths[@]} == 0)); then
		tmpdir=$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || printf '%s' "${TMPDIR:-}")
		paths=("$HOME")
		[[ -n $tmpdir && -d $tmpdir ]] && paths+=("${tmpdir%/}")
	fi
	mkdir -p "$dir"
	stamp=$(date +%Y%m%dT%H%M%S)
	out="$dir/$stamp.tsv"
	{
		printf '# dotmac disk snapshot %s\n' "$stamp"
		printf '# free_kb\t%s\n' "$(df -k "$HOME" | awk 'NR==2{print $4}')"
		# dua lines look like "BYTES b PATH <N IO Errors>"; keep bytes and path.
		dua --format bytes aggregate --depth 2 "${paths[@]}" 2>/dev/null \
			| sed -E 's/ +<[0-9]+ IO Errors?>$//' \
			| awk '$2 == "b" && $3 != "total" { b=$1; $1=""; $2=""; sub(/^  /, ""); printf "%s\t%s\n", b, $0 }'
	} > "$out.partial"
	mv "$out.partial" "$out"
	result true disk-snapshot "$out" saved 0 "snapshot: $out ($(($(wc -l < "$out") - 2)) entries)"
}

disk_diff() {
	local dir old new
	dir=$(disk_dir)
	if (($# == 2)); then
		old=$1 new=$2
	elif (($# == 0)); then
		new=$(ls -1 "$dir"/*.tsv 2>/dev/null | tail -1 || true)
		old=$(ls -1 "$dir"/*.tsv 2>/dev/null | tail -2 | head -1 || true)
		[[ -n $old && $old != "$new" ]] || fail "need two snapshots in $dir" 2
	else
		fail 'usage: scripts/dotmac disk diff [OLD NEW]' 2
	fi
	[[ -f $old && -f $new ]] || fail "snapshot not found: $old or $new" 2
	local report
	report=$(awk -F'\t' '
		FNR == 1 { file++ }
		/^# free_kb/ { free[file] = $2; next }
		/^#/ { next }
		file == 1 { a[$2] = $1; seen[$2] = 1 }
		file == 2 { b[$2] = $1; seen[$2] = 1 }
		END {
			printf "free space change: %+.1f GB\n", (free[2] - free[1]) / 1048576
			fflush()
			for (p in seen) {
				d = b[p] - a[p]
				if (d != 0) printf "%d\t%+.2f GB\t%s\n", (d < 0 ? -d : d), d / 1073741824, p | "sort -g -r -k1,1 | head -25 | cut -f2-"
			}
		}' "$old" "$new")
	result true disk-diff "$old -> $new" compared 0 "$report"
}

show_profiles() {
	if (( json )); then
		printf '{"profiles":['
		printf '{"name":"essential","description":"Baseline tools with Rectangle and 1Password"},'
		printf '{"name":"development","description":"Daily development tools with optional 1Password CLI"},'
		printf '{"name":"gui-apps","description":"Optional GUI apps: Zed and Obsidian"},'
		printf '{"name":"data","description":"Data and research tools"},'
		printf '{"name":"diagnostics","description":"Optional memory and disk diagnostics tools"}]}'
		printf '\n'
	else
		cat <<'EOF'
Profiles:
  essential    Baseline tools with Rectangle and 1Password
  development  Daily development tools with optional 1Password CLI
  gui-apps     Optional GUI apps: Zed and Obsidian
  data         Data and research tools
  diagnostics  Optional memory and disk diagnostics tools
EOF
	fi
}

if [[ ${1:-} == --json ]]; then
	json=1
	shift
fi

command_name=${1:-}
[[ -n $command_name ]] || fail 'missing command; run scripts/dotmac --help' 2
shift

case $command_name in
	-h|--help|help) usage ;;
	--version|version)
		(($# == 0)) || fail 'version takes no arguments' 2
		version=$(git -C "$repo_dir" describe --always --dirty 2>/dev/null || printf 'unknown')
		if (( json )); then
			printf '{"name":"dotmac","revision":'
			json_quote "$version"
			printf '}\n'
		else
			printf 'dotmac %s\n' "$version"
		fi
		;;
	profiles)
		if [[ ${1:-} == -h || ${1:-} == --help ]]; then usage; exit 0; fi
		(($# == 0)) || fail 'profiles takes no arguments' 2
		show_profiles
		;;
	plan|outdated|apply|upgrade) profile_command "$command_name" "$@" ;;
	inventory)
		if [[ ${1:-} == -h || ${1:-} == --help ]]; then usage; exit 0; fi
		inventory_command "$@"
		;;
	home)
		if [[ ${1:-} == -h || ${1:-} == --help ]]; then usage; exit 0; fi
		(($# >= 1)) || fail 'usage: scripts/dotmac home check|apply' 2
		home_command "$@"
		;;
	preferences)
		if [[ ${1:-} == -h || ${1:-} == --help ]]; then usage; exit 0; fi
		preferences_command "$@"
		;;
	disk)
		if [[ ${1:-} == -h || ${1:-} == --help ]]; then usage; exit 0; fi
		(($# >= 1)) || fail 'usage: scripts/dotmac disk snapshot|diff' 2
		sub=$1
		shift
		case $sub in
			snapshot) disk_snapshot "$@" ;;
			diff) disk_diff "$@" ;;
			*) fail "unknown disk command '$sub'" 2 ;;
		esac
		;;
	*) fail "unknown command '$command_name'; run 'scripts/dotmac --help'" 2 ;;
esac
